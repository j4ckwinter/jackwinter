---
import Section from "./Section.astro";
import ContributionGraph from "./ContributionGraph.astro";
import RecentCommits from "./RecentCommits.astro";
import type { ContributionGrid } from "../github/activity";
import type { Commit } from "../github/client";
import type { Project } from "../content/projects";

type Props = {
  contributions: ContributionGrid | undefined;
  commits: Commit[];
  projects: Project[];
  profileUrl: string;
  today: string;
};
const { contributions, commits, projects, profileUrl, today } = Astro.props;
---

{
  (contributions || commits.length > 0) && (
    <Section title="Activity" class="print:hidden">
      {contributions && <ContributionGraph activity={contributions} profileUrl={profileUrl} today={today} />}
      {commits.length > 0 && <RecentCommits commits={commits} projects={projects} today={today} />}
    </Section>
  )
}
