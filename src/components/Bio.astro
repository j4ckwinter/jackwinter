---
type Props = { paragraphs: string[]; email: string };
const { paragraphs, email } = Astro.props;
---

<div class="flex flex-col gap-3 leading-relaxed">
  {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  <p class="mt-3">
    <a
      class="inline-flex h-8 items-center rounded-lg bg-fg px-3 text-sm font-medium text-surface transition-transform hover:bg-fg/85 active:scale-[0.97]"
      href={`mailto:${email}`}
    >
      say hello
    </a>
  </p>
</div>
