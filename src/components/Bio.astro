---
type Props = { paragraphs: string[]; email: string };
const { paragraphs, email } = Astro.props;
---

<div class="flex flex-col gap-3 leading-relaxed">
  {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  <p class="mt-3">
    <a
      class="inline-flex h-8 items-center rounded-lg bg-neutral-950 px-3 text-sm font-medium text-white transition-transform hover:bg-neutral-800 active:scale-[0.97] dark:bg-neutral-50 dark:text-neutral-950 dark:hover:bg-neutral-200"
      href={`mailto:${email}`}
    >
      say hello
    </a>
  </p>
</div>
