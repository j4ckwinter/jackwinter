---
import Section from "./Section.astro";
import SeeMore from "./SeeMore.astro";
import IconTile from "./IconTile.astro";
import Icon from "./Icon.astro";
import DateRange from "./DateRange.astro";
import type { Role } from "../content/experience";
import { displayHost, formatTenure } from "../format";
import { monthsSpanned } from "../tenure";
import { roleNames } from "../role-names";
import { disclosureButton } from "../scripts/disclosure";
import { caseStudyFor, caseStudyPath } from "../content/case-studies";

type Props = { roles: Role[]; today: string };
const { roles, today } = Astro.props;

const site = Astro.site && displayHost(Astro.site);
const entries = roles.map((role) => {
  const names = roleNames(role);
  return {
    role,
    names,
    current: role.end === undefined,
    tenure: formatTenure(monthsSpanned(role, today)),
    caseStudy: caseStudyFor(role.company),
  };
});
const columns = `grid-template-columns: repeat(${roles.length}, minmax(0, 1fr))`;
---

<Section title="Experience">
  <SeeMore slot="action" controls="experience-content" subject="experience" class="max-xp:hidden" />
  <div id="experience-content">
    <div class="relative hidden pb-2 xp:block xp:in-opened:hidden xp:no-js:hidden">
      <span aria-hidden="true" class="absolute top-1 right-2 left-3 h-px bg-line"></span>
      <ol class="grid gap-2" style={columns}>
        {entries.map(({ role, current, names }) => (
          <li class="group/stop relative min-w-0 pt-6 pr-2">
            <button
              type="button"
              {...disclosureButton("experience-content", names.row)}
              aria-label={`Open the details for ${role.company}`}
              class="absolute -inset-x-2 top-3 -bottom-2 z-20 rounded-xl"
            ></button>
            {current && <span aria-hidden="true" class="absolute top-1 left-3 h-px w-[calc(100%+0.5rem)] bg-linear-to-r from-fg to-line to-70%" />}
            <span aria-hidden="true" class="absolute -top-1 left-1 z-10 flex size-4 items-center justify-center rounded-full bg-surface">
              <span class:list={["relative size-2 rounded-full", current ? "bg-fg" : "bg-faint"]}>
                {current && <span class="absolute inset-0 animate-halo rounded-full bg-fg motion-reduce:animate-none" />}
              </span>
            </span>
            <div class="flex min-w-0 items-center gap-2.5">
              <IconTile icon={role.icon} transitionName={names.mark} />
              <span class="line-clamp-2 text-sm leading-snug underline-offset-3 decoration-line group-hover/stop:underline" style={`view-transition-name: ${names.company}`}>{role.company}</span>
            </div>
            <p class="mt-2 w-fit text-[13px] text-fg-muted" style={`view-transition-name: ${names.dates}`}><DateRange start={role.start} end={role.end} /></p>
          </li>
        ))}
      </ol>
    </div>
    <ol class="flex flex-col gap-5.5 xp:hidden xp:in-opened:flex xp:no-js:flex">
      {entries.map(({ role, tenure, caseStudy, names }) => (
        <li id={names.row} tabindex="-1" class="-mx-3 min-w-0 scroll-mt-8 rounded-xl px-3 outline-none transition-colors duration-700 data-highlight:bg-raised data-highlight:duration-150" style={`view-transition-name: ${names.row}`}>
          <div class="group/role relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-2.5">
            <button
              type="button"
              {...disclosureButton(names.details)}
              aria-label={`Details for ${role.company}`}
              class="absolute -inset-x-3 -inset-y-2 rounded-xl hover:bg-raised xp:hidden no-js:hidden"
            ></button>
            <IconTile icon={role.icon} transitionName={names.mark} class="pointer-events-none relative max-xp:self-start" />
            <div class="pointer-events-none relative min-w-0">
              <p class="w-fit text-sm" style={`view-transition-name: ${names.company}`}>{role.company}</p>
              <p class="text-[13px] text-fg-secondary">{role.title}</p>
              <p class="mt-0.5 text-[12px] text-fg-muted tabular-nums xp:hidden">
                <span style={`view-transition-name: ${names.dates}`}><DateRange start={role.start} end={role.end} /></span> · {tenure}
              </p>
            </div>
            <div class="pointer-events-none relative hidden flex-col items-end self-start text-[13px] whitespace-nowrap text-fg-muted xp:flex">
              <p>
                <span style={`view-transition-name: ${names.dates}`}><DateRange start={role.start} end={role.end} /></span> · {role.location}
              </p>
              <p class="text-[12px] tabular-nums">{tenure}</p>
            </div>
            <Icon name="chevronDown" class="pointer-events-none relative size-3.5 self-start text-fg-muted transition-transform duration-(--duration-flip) group-has-aria-expanded/role:rotate-180 xp:hidden no-js:hidden" />
          </div>
          <div id={names.details} class="reveal relative mt-3 hidden pl-[42px] opened:block xp:block">
            <span data-thread aria-hidden="true" class="absolute top-0 bottom-1 left-[15.5px] w-px bg-line xp:hidden print:hidden"></span>
            <p class="text-[13px] text-fg-secondary">{role.context}</p>
            <ul class="mt-2 flex list-disc flex-col gap-1.5 pl-4 text-[13px] text-fg-secondary marker:text-faint">
              {role.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
            {caseStudy && (
              <p class="mt-3 text-[13px]">
                <a href={caseStudyPath(caseStudy)} data-astro-prefetch class="inline-flex items-center gap-1 py-1 text-fg underline decoration-line underline-offset-3 hover:decoration-fg-muted print:no-underline">
                  read the case study <span aria-hidden="true" class="print:hidden">→</span>
                </a>
                <span class="hidden text-fg-muted print:inline">at {site}{caseStudyPath(caseStudy)}</span>
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Section>
