---
import Icon from "./Icon.astro";
import type { Link } from "../content/profile";
import { displayHost } from "../format";

type Props = { name: string; title: string; links: Link[]; email: string; hello: string; qr?: string };
const { name, title, links, email, hello, qr } = Astro.props;
const printable = links.filter((link) => !link.href.startsWith("/")).map((link) => link.href.replace(/^(mailto:|https?:\/\/)/, ""));
const site = Astro.site && displayHost(Astro.site);
const isEmail = (link: Link) => link.href === `mailto:${email}`;
const iconButton = "inline-flex size-7 items-center justify-center rounded-md text-fg-secondary transition-transform hover:bg-hover hover:text-fg active:scale-[0.97]";
---

<header class="flex items-center justify-between gap-4">
  <div>
    <h1 class="font-medium">{name}</h1>
    <p class="mt-1 text-fg-muted">
      {title}
    </p>
    <p class="mt-1 hidden text-[13px] text-fg-secondary print:block">{[...printable, site].filter(Boolean).join(" · ")}</p>
  </div>
  <nav aria-label="Links" class="relative print:hidden">
    <ul class="flex gap-px">
      {links.map((link) => (
        <li>
          <a
            href={isEmail(link) ? hello : link.href}
            data-copy-email={isEmail(link) ? email : undefined}
            aria-label={link.label}
            title={link.label}
            class={iconButton}
          >
            <Icon name={link.icon} />
          </a>
        </li>
      ))}
      <li class="no-js:hidden">
        <button type="button" data-theme-toggle aria-label="Switch between light and dark" title="Switch between light and dark" class={iconButton}>
          <Icon name="moon" class="size-4 shows-dark:hidden" />
          <Icon name="sun" class="hidden size-4 shows-dark:block" />
        </button>
      </li>
    </ul>
    <span data-copy-status aria-live="polite" class="absolute top-full right-1 mt-1 text-[12px] whitespace-nowrap text-fg-muted opacity-0 transition-opacity duration-300 data-shown:opacity-100"></span>
  </nav>
  {qr && <div role="img" aria-label={`QR code for ${site}`} class="hidden size-16 shrink-0 print:block" set:html={qr} />}
</header>
