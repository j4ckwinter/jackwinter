---
import Section from "./Section.astro";
import IconTile from "./IconTile.astro";
import Icon from "./Icon.astro";
import type { Project } from "../content/projects";
import { formatCount } from "../format";

type Props = { projects: Project[]; stars: Map<string, number>; versions: Map<string, string> };
const { projects, stars, versions } = Astro.props;
const starsFor = (project: Project) => stars.get(project.repo) ?? 0;
const mostStarredFirst = [...projects].sort((a, b) => starsFor(b) - starsFor(a));
---

<Section title="Projects">
  <ul class="flex flex-col gap-2">
    {mostStarredFirst.map((project) => {
      const starCount = starsFor(project);
      const version = versions.get(project.repo);
      return (
        <li>
          <a href={project.href} class="group/project -mx-3 grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl px-3 py-2 transition-colors hover:bg-raised xp:grid-cols-[auto_minmax(0,1fr)_auto]">
            <IconTile icon={project.icon} class="max-xp:row-span-2 max-xp:self-start" />
            <span class="flex min-w-0 flex-col">
              <span class="flex items-center gap-1 text-sm">
                {project.name}
                <Icon name="arrowUpRight" class="size-3.5 -translate-x-1 text-fg-muted opacity-0 transition duration-200 group-hover/project:translate-x-0 group-hover/project:opacity-100 group-focus-visible/project:translate-x-0 group-focus-visible/project:opacity-100 motion-reduce:transition-none print:hidden" />
              </span>
              <span class="text-[13px] text-fg-secondary">{project.description}</span>
            </span>
            {(version || starCount > 0) && (
              <span class="flex shrink-0 items-center gap-3">
                {version && (
                  <span class="font-mono text-[12px] text-fg-muted">
                    <span class="sr-only">Latest release: </span>v{version}
                  </span>
                )}
                {starCount > 0 && (
                  <span class="flex items-center gap-1 text-[13px] text-fg-muted tabular-nums">
                    <Icon name="star" class="size-3.5" />
                    <span><span class="sr-only">GitHub stars: </span>{formatCount(starCount)}</span>
                  </span>
                )}
              </span>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</Section>
