---
import { toSlug } from "../slug";

type Props = { title: string };
const { title } = Astro.props;
const id = toSlug(title);
---

<section aria-labelledby={id} class="flex flex-col gap-5" style={`view-transition-name: section-${id}`}>
  <div class="flex items-center justify-between">
    <h2 id={id}>{title}</h2>
    <slot name="action" />
  </div>
  <slot />
</section>
