---
import Section from "./Section.astro";
import SeeMore from "./SeeMore.astro";
import Icon from "./Icon.astro";
import { hiddenToolCount, type SkillGroup } from "../content/skills";
import { toSlug } from "../slug";

type Props = { groups: SkillGroup[] };
const { groups } = Astro.props;
const heading = toSlug("Skills");
---

<Section title="Skills">
  <SeeMore slot="action" controls="skills-content" subject="skills" hiddenCount={hiddenToolCount(groups)} />
  <div id="skills-content" class="flex flex-col gap-4">
    {groups.map((group) => (
      <div class="grid grid-cols-[clamp(6.4rem,20vw,8rem)_minmax(0,1fr)] gap-2" style={`view-transition-name: skills-${toSlug(group.name)}`}>
        <h3 class="text-[13px] leading-6 text-fg-muted">{group.name}</h3>
        <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
          {group.tools.map((tool, index) => (
            <li class:list={["text-sm leading-6", index >= group.shownBeforeExpanding && "reveal hidden in-opened:block"]}>
              <span class="inline-flex items-center gap-1.5">
                <Icon name={tool.icon} class="size-3.5 text-fg-muted" />
                {tool.name}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div class="reveal hidden justify-end in-opened:flex no-js:hidden print:hidden">
      <SeeMore controls="skills-content" subject="skills" returnTo={heading} />
    </div>
  </div>
</Section>
