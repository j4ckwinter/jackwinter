---
import "../styles/global.css";

type Props = { title: string; description: string };
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="bg-surface font-sans text-fg antialiased">
    <main class="mx-auto flex min-h-svh w-full max-w-[700px] flex-col gap-10 px-5 pt-8 pb-24 sm:px-8 md:pt-14">
      <slot />
    </main>
    <script>
      import { enhanceDisclosures } from "../scripts/disclosure";

      enhanceDisclosures(document, () => matchMedia("(prefers-reduced-motion: reduce)").matches);
    </script>
  </body>
</html>
