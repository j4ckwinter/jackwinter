---
import { statSync } from "node:fs";
import { join } from "node:path";
import Page from "../layouts/Page.astro";
import Header from "../components/Header.astro";
import Bio from "../components/Bio.astro";
import Activity from "../components/Activity.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import { lastSourceChange } from "../site-updated";
import { helloHref } from "../contact";
import { formatFileSize } from "../format";
import { page } from "../content/page";
import { githubDataForBuild } from "../github/build-data";
import { personSchema } from "../agents/structured-data";
import { wholeYearsAcross } from "../tenure";

const { profile, experience, education, skills, projects } = page;

const github = await githubDataForBuild();
const today = new Date().toISOString().slice(0, 10);
const updated = lastSourceChange() ?? today;
const structuredData = JSON.stringify(personSchema(page, Astro.site!));
---

<Page title={`${profile.name} · ${profile.title}`} description={profile.description} name={profile.name}>
  <script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
  <Header name={profile.name} title={profile.title} links={profile.links} />
  <Bio paragraphs={profile.bio(wholeYearsAcross(experience, today))} email={profile.email} hello={helloHref(profile.email, Astro.site!)} cv={{ href: profile.cv, size: formatFileSize(statSync(join(process.cwd(), "public", profile.cv)).size) }} />
  <Experience roles={experience} today={today} />
  <Projects projects={projects} stars={github.stars} versions={github.versions} />
  <Activity contributions={github.activity} commits={github.commits} projects={projects} profileUrl={profile.githubUrl} today={today} />
  <Skills groups={skills} />
  <Education qualifications={education} />
  <Footer updated={updated} today={today} />
</Page>
