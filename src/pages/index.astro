---
import Page from "../layouts/Page.astro";
import { profile } from "../content/profile";
---

<Page title={profile.name}>
  <header>
    <h1 class="text-xl font-medium">{profile.name}</h1>
    <p class="text-neutral-500">{profile.title}</p>
    <nav class="mt-4 flex gap-4 text-sm">
      {profile.links.map((link) => <a class="underline-offset-4 hover:underline" href={link.href}>{link.label}</a>)}
    </nav>
  </header>
</Page>
