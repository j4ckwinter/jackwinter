---
import Page from "../../layouts/Page.astro";
import CaseStudyBody from "../../components/CaseStudyBody.astro";
import IconTile from "../../components/IconTile.astro";
import { caseStudies, caseStudyPath } from "../../content/case-studies";
import { readingMinutes } from "../../content/case-studies/reading-time";
import type { CaseStudy } from "../../content/case-studies/types";
import { page } from "../../content/page";
import { displayHost, formatDateRange } from "../../format";
import { roleNames } from "../../role-names";
import { helloHref } from "../../contact";
import { caseStudySchema } from "../../agents/structured-data";
import { caseStudyCardAlt, caseStudyCardPath } from "../../social/card";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

type Props = { study: CaseStudy };
const { study } = Astro.props;
const { profile } = page;
const role = page.experience.find((entry) => entry.company === study.company);
const names = role && roleNames(role);
const address = `${displayHost(Astro.site!)}${caseStudyPath(study)}`;
const structuredData = JSON.stringify(caseStudySchema(study, profile, Astro.site!));
const link = "underline decoration-line underline-offset-3 hover:decoration-fg-muted";
---

<Page
  title={`${study.title} · ${profile.name}`}
  description={study.summary}
  name={profile.name}
  type="article"
  card={{ path: caseStudyCardPath(study.slug), alt: caseStudyCardAlt(study) }}
>
  <script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
  <nav aria-label="Back" class="text-[13px] text-fg-muted print:hidden">
    <a class={`inline-block py-1 hover:text-fg ${link}`} href={names ? `/#${names.row}` : "/#experience"} data-astro-prefetch>← {profile.name}</a>
  </nav>
  <CaseStudyBody study={study}>
    <p slot="eyebrow" class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[13px] text-fg-muted">
      {role && names && <IconTile icon={role.icon} transitionName={names.mark} class="mr-1 print:hidden" />}
      <span class="text-fg" style={names && `view-transition-name: ${names.company}`}>{study.company}</span>
      {role && names && <><span aria-hidden="true">·</span><span style={`view-transition-name: ${names.dates}`}>{formatDateRange(role)}</span></>}
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(study)} min read</span>
      <span class="hidden w-full print:block">{profile.name} · {address}</span>
    </p>
  </CaseStudyBody>
  <footer class="flex flex-col gap-3 border-t border-line pt-8 print:hidden">
    <p class="font-medium">let's talk frontend.</p>
    <p class="text-fg-secondary">architecture, real-time interfaces and performance.</p>
    <p class="flex gap-3">
      <a class="inline-flex h-8 items-center rounded-lg bg-fg px-3 text-sm font-medium text-surface transition-transform hover:bg-fg/85 active:scale-[0.97]" href={helloHref(profile.email, Astro.site!)}>say hello</a>
      <a class="inline-flex h-8 items-center px-1 text-sm text-fg-secondary hover:text-fg" href="/">back to the start</a>
    </p>
  </footer>
</Page>
